# --- Servidor ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://aquabrain:aquabrain@localhost:5432/aquabrain?schema=public

# --- Redis (reservado) ---
# Previsto en el diseño de ES2 para caché y control de tasa distribuido. El
# prototipo usa el almacenamiento en memoria de @nestjs/throttler y el bloqueo
# por intentos fallidos en PostgreSQL, por lo que esta variable no se consume
# todavía (ver ES3 §11 «Análisis de discrepancias»).
REDIS_URL=redis://localhost:6379/0

# --- Seguridad ---
JWT_ACCESS_SECRET=cambiar_por_secreto_largo_aleatorio_de_al_menos_32_bytes
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_largo_aleatorio_de_32_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
DEVICE_KEY_PEPPER=cambiar_por_pepper_de_al_menos_32_bytes

# --- Ingesta ---
ALERT_SILENCE_FACTOR=3
MAX_TIMESTAMP_SKEW=5m
BODY_LIMIT=1mb

# --- CORS (lista explícita, sin comodines) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
