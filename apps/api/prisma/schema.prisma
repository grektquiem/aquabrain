// ============================================================
// AQUAPLANTS / AQUABRAIN — Prisma schema
// ES3 · Implementación de la solución
// Trazabilidad: docs/ES2/05-modelo-de-datos.md (DER, diccionario, índices)
//               docs/ES2/aquaplants_schema.sql (DDL de referencia ES2)
// Herramienta de migración: Prisma Migrate (doc 05 §9).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enumeraciones (doc 05 §3, MC-05) ----------

enum EstadoSistema {
  ACTIVO
  MANTENCION
  INACTIVO
}

enum EstadoCultivo {
  ACTIVO
  COSECHADO
  CERRADO
}

enum EstadoPlanta {
  SANA
  EN_RIESGO
  RETIRADA
}

enum EstadoConexion {
  EN_LINEA
  SIN_COMUNICACION
  INACTIVO
  DESCONOCIDO
}

enum OrigenDato {
  REAL
  SIMULADO
}

enum OrigenMedicion {
  ONLINE
  OFFLINE
  MANUAL
}

enum CalidadMedicion {
  OK
  SOSPECHOSA
  ANULADA
}

enum OperadorRegla {
  MAYOR_QUE
  MENOR_QUE
  FUERA_DE_RANGO
  DENTRO_DE_RANGO
  SIN_DATOS
}

enum Severidad {
  ALTA
  MEDIA
  BAJA
  INFO
}

enum EstadoAlerta {
  ACTIVA
  RESUELTA
}

enum TipoAlerta {
  UMBRAL
  SIN_COMUNICACION
  SINCRONIZACION
  ERROR_DISPOSITIVO
}

enum TipoEvento {
  SIN_COMUNICACION
  RECONEXION
  REINTENTO_SINCRONIZACION
  ERROR_SENSOR
  CAMBIO_CONFIGURACION
  DESPLIEGUE
}

// ---------- Seguridad y usuarios (doc 05 §3.1) ----------

model Rol {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String   @unique @db.VarChar(50)
  descripcion String?  @db.VarChar(200)
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuarios    Usuario[]
  rolPermisos RolPermiso[]

  @@map("rol")
}

model Permiso {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String @unique @db.VarChar(60) // formato 'recurso:accion'
  descripcion String? @db.VarChar(200)

  rolPermisos RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  rolId     String @map("rol_id") @db.Uuid
  permisoId String @map("permiso_id") @db.Uuid

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

model Usuario {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String    @db.VarChar(120)
  email             String    @db.VarChar(180)
  passwordHash      String    @map("password_hash") @db.VarChar(60)
  rolId             String    @map("rol_id") @db.Uuid
  activo            Boolean   @default(true)
  intentosFallidos  Int       @default(0) @map("intentos_fallidos") @db.SmallInt
  bloqueadoHasta    DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)
  ultimoAcceso      DateTime? @map("ultimo_acceso") @db.Timestamptz(6)
  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn     DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  rol            Rol             @relation(fields: [rolId], references: [id], onDelete: Restrict)
  refreshTokens  RefreshToken[]
  auditorias     Auditoria[]
  reglasCreadas  ReglaAlerta[]
  alertasResueltas Alerta[]      @relation("AlertaResueltaPor")

  @@unique([email], map: "uq_usuario_email")
  @@index([rolId])
  @@map("usuario")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(6)
  revocadoEn DateTime? @map("revocado_en") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ip         String?   @db.Inet
  creadoEn   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiraEn], map: "idx_refresh_token_expira") // I-11
  @@map("refresh_token")
}

model Auditoria {
  id           BigInt   @id @default(autoincrement())
  usuarioId    String?  @map("usuario_id") @db.Uuid
  accion       String   @db.VarChar(40)
  entidad      String?  @db.VarChar(40)
  entidadId    String?  @map("entidad_id") @db.VarChar(64)
  datosAntes   Json?    @map("datos_antes") @db.JsonB
  datosDespues Json?    @map("datos_despues") @db.JsonB
  ip           String?  @db.Inet
  ocurridoEn   DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(6)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([ocurridoEn(sort: Desc)], map: "idx_auditoria_ocurrido") // I-10
  @@index([usuarioId, ocurridoEn(sort: Desc)], map: "idx_auditoria_usuario")
  @@map("auditoria")
}

// ---------- Dominio: sistemas, cultivos, dispositivos y sensores (doc 05 §3.2–3.3) ----------

model Sistema {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo        String        @unique @db.VarChar(30)
  nombre        String        @db.VarChar(120)
  descripcion   String?       @db.VarChar(255)
  ubicacion     String?       @db.VarChar(80)
  latitud       Decimal?      @db.Decimal(9, 6)
  longitud      Decimal?      @db.Decimal(9, 6)
  estado        EstadoSistema @default(ACTIVO)
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  cultivos     Cultivo[]
  dispositivos Dispositivo[]
  alertas      Alerta[]
  eventos      Evento[]

  @@map("sistema")
}

model Cultivo {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sistemaId         String        @map("sistema_id") @db.Uuid
  nombre            String        @db.VarChar(120)
  especie           String        @db.VarChar(80)
  variedad          String?       @db.VarChar(80)
  fechaInicio       DateTime      @map("fecha_inicio") @db.Date
  fechaFinEstimada  DateTime?     @map("fecha_fin_estimada") @db.Date
  estado            EstadoCultivo @default(ACTIVO)
  fotoperiodoHoras  Decimal?      @map("fotoperiodo_horas") @db.Decimal(4, 1)
  creadoEn          DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)

  sistema        Sistema         @relation(fields: [sistemaId], references: [id], onDelete: Restrict)
  plantas        Planta[]
  cultivoSensores CultivoSensor[]

  @@map("cultivo")
}

model Planta {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cultivoId String       @map("cultivo_id") @db.Uuid
  codigo    String       @db.VarChar(30)
  posicion  String?      @db.VarChar(30)
  estado    EstadoPlanta @default(SANA)
  creadoEn  DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)

  cultivo Cultivo @relation(fields: [cultivoId], references: [id], onDelete: Cascade)

  @@unique([cultivoId, codigo])
  @@map("planta")
}

model Dispositivo {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sistemaId            String         @map("sistema_id") @db.Uuid
  codigo               String         @unique @db.VarChar(40)
  modelo               String         @default("AquaBrain") @db.VarChar(60)
  firmware             String?        @db.VarChar(30)
  intervaloReporteSeg  Int            @default(300) @map("intervalo_reporte_seg")
  apiKeyHash           String         @map("api_key_hash") @db.VarChar(255)
  apiKeyUltimos4       String?        @map("api_key_ultimos4") @db.VarChar(4)
  estadoConexion       EstadoConexion @default(DESCONOCIDO) @map("estado_conexion")
  ultimaComunicacion   DateTime?      @map("ultima_comunicacion") @db.Timestamptz(6)
  activo               Boolean        @default(true)
  creadoEn             DateTime       @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime       @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  sistema              Sistema               @relation(fields: [sistemaId], references: [id], onDelete: Restrict)
  sensores             Sensor[]
  mediciones           Medicion[]
  eventos              Evento[]
  estadoSensorActual   EstadoSensorActual[]
  medicionIdempotencia MedicionIdempotencia[]

  @@index([sistemaId, estadoConexion], map: "idx_dispositivo_sistema_estado") // I-08
  @@map("dispositivo")
}

model TipoVariable {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo        String     @unique @db.VarChar(30)
  nombre        String     @db.VarChar(80)
  unidadDefecto String     @map("unidad_defecto") @db.VarChar(20)
  origenDato    OrigenDato @map("origen_dato")
  valorMin      Decimal?   @map("valor_min") @db.Decimal(12, 4)
  valorMax      Decimal?   @map("valor_max") @db.Decimal(12, 4)

  sensores Sensor[]
  reglas   ReglaAlerta[]

  @@map("tipo_variable")
}

model Sensor {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispositivoId   String   @map("dispositivo_id") @db.Uuid
  tipoVariableId  String   @map("tipo_variable_id") @db.Uuid
  codigo          String   @db.VarChar(40)
  nombre          String   @db.VarChar(80)
  unidad          String   @db.VarChar(20)
  rangoMin        Decimal? @map("rango_min") @db.Decimal(12, 4)
  rangoMax        Decimal? @map("rango_max") @db.Decimal(12, 4)
  ubicacionFisica String?  @map("ubicacion_fisica") @db.VarChar(80)
  activo          Boolean  @default(true)
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  dispositivo    Dispositivo         @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  tipoVariable   TipoVariable        @relation(fields: [tipoVariableId], references: [id], onDelete: Restrict)
  mediciones     Medicion[]
  idempotencias  MedicionIdempotencia[]
  reglas         ReglaAlerta[]
  alertas        Alerta[]
  cultivos       CultivoSensor[]
  estadoActual   EstadoSensorActual?

  @@unique([dispositivoId, codigo])
  @@map("sensor")
}

model CultivoSensor {
  cultivoId String @map("cultivo_id") @db.Uuid
  sensorId  String @map("sensor_id") @db.Uuid

  cultivo Cultivo @relation(fields: [cultivoId], references: [id], onDelete: Cascade)
  sensor  Sensor  @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@id([cultivoId, sensorId])
  @@map("cultivo_sensor")
}

// ---------- Mediciones (append-only), reglas, alertas y eventos ----------

model Medicion {
  id              BigInt          @default(autoincrement())
  sensorId        String          @map("sensor_id") @db.Uuid
  dispositivoId   String          @map("dispositivo_id") @db.Uuid
  valor           Decimal?        @db.Decimal(12, 4)
  valorTexto      String?         @map("valor_texto") @db.VarChar(120)
  unidad          String          @db.VarChar(20)
  timestamp       DateTime        @db.Timestamptz(6)
  recibidoEn      DateTime        @default(now()) @map("recibido_en") @db.Timestamptz(6)
  origen          OrigenMedicion  @default(ONLINE)
  idExterno       String?         @map("id_externo") @db.VarChar(80)
  calidad         CalidadMedicion @default(OK)
  alertaGenerada  Boolean         @default(false) @map("alerta_generada")
  payloadCrudoId  String?         @map("payload_crudo_id") @db.VarChar(64)

  sensor      Sensor      @relation(fields: [sensorId], references: [id], onDelete: Restrict)
  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Restrict)

  @@id([id, timestamp])
  @@index([sensorId, timestamp(sort: Desc)], map: "idx_medicion_sensor_ts") // I-01
  @@index([dispositivoId, timestamp(sort: Desc)], map: "idx_medicion_dispositivo_ts") // I-02
  @@index([timestamp], map: "idx_medicion_timestamp") // I-03
  @@map("medicion")
}

model MedicionIdempotencia {
  dispositivoId String   @map("dispositivo_id") @db.Uuid
  idExterno     String   @map("id_externo") @db.VarChar(80)
  sensorId      String   @map("sensor_id") @db.Uuid
  recibidoEn    DateTime @default(now()) @map("recibido_en") @db.Timestamptz(6)

  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  sensor      Sensor      @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@id([dispositivoId, idExterno]) // I-04 · MC-08 · idempotencia HU10
  @@map("medicion_idempotencia")
}

model EstadoSensorActual {
  sensorId      String   @id @map("sensor_id") @db.Uuid
  dispositivoId String   @map("dispositivo_id") @db.Uuid
  valor         Decimal? @db.Decimal(12, 4)
  valorTexto    String?  @map("valor_texto") @db.VarChar(120)
  unidad        String   @db.VarChar(20)
  timestamp     DateTime @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  sensor      Sensor      @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  // I-12 · DN-05: la consulta más frecuente del dashboard.
  @@map("estado_sensor_actual")
}

model ReglaAlerta {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sensorId       String?       @map("sensor_id") @db.Uuid
  tipoVariableId String?       @map("tipo_variable_id") @db.Uuid
  nombre         String        @db.VarChar(120)
  operador       OperadorRegla
  umbralMin      Decimal?      @map("umbral_min") @db.Decimal(12, 4)
  umbralMax      Decimal?      @map("umbral_max") @db.Decimal(12, 4)
  severidad      Severidad
  cooldownSeg    Int           @default(900) @map("cooldown_seg")
  activa         Boolean       @default(true)
  creadoPor      String        @map("creado_por") @db.Uuid
  creadoEn       DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  sensor       Sensor?   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  tipoVariable TipoVariable? @relation(fields: [tipoVariableId], references: [id], onDelete: Cascade)
  creador      Usuario   @relation(fields: [creadoPor], references: [id], onDelete: Restrict)
  alertas      Alerta[]

  @@index([activa, sensorId], map: "idx_regla_activa_sensor") // I-07
  @@index([activa, tipoVariableId], map: "idx_regla_activa_tipo") // I-07
  @@map("regla_alerta")
}

model Alerta {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reglaId              String?       @map("regla_id") @db.Uuid
  medicionId           BigInt?       @map("medicion_id")
  sensorId             String        @map("sensor_id") @db.Uuid
  sistemaId            String        @map("sistema_id") @db.Uuid
  tipo                 TipoAlerta    @default(UMBRAL)
  severidad            Severidad
  estado               EstadoAlerta  @default(ACTIVA)
  mensaje              String        @db.VarChar(300)
  valorDetectado       Decimal?      @map("valor_detectado") @db.Decimal(12, 4)
  umbralAplicado       String?       @map("umbral_aplicado") @db.VarChar(60)
  creadaEn             DateTime      @default(now()) @map("creada_en") @db.Timestamptz(6)
  resueltaPor          String?       @map("resuelta_por") @db.Uuid
  resueltaEn           DateTime?     @map("resuelta_en") @db.Timestamptz(6)
  comentarioResolucion String?       @map("comentario_resolucion")

  regla         ReglaAlerta? @relation(fields: [reglaId], references: [id], onDelete: SetNull)
  sensor        Sensor       @relation(fields: [sensorId], references: [id], onDelete: Restrict)
  sistema       Sistema      @relation(fields: [sistemaId], references: [id], onDelete: Restrict)
  usuarioResuelve Usuario?   @relation("AlertaResueltaPor", fields: [resueltaPor], references: [id], onDelete: SetNull)

  @@index([estado, severidad, creadaEn(sort: Desc)], map: "idx_alerta_estado") // I-05
  @@index([sistemaId, estado])
  @@map("alerta")
}

model Evento {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispositivoId String?    @map("dispositivo_id") @db.Uuid
  sistemaId     String     @map("sistema_id") @db.Uuid
  tipo          TipoEvento
  severidad     Severidad
  descripcion   String     @db.VarChar(300)
  datos         Json?      @db.JsonB
  ocurridoEn    DateTime   @default(now()) @map("ocurrido_en") @db.Timestamptz(6)

  dispositivo Dispositivo? @relation(fields: [dispositivoId], references: [id], onDelete: SetNull)
  sistema     Sistema      @relation(fields: [sistemaId], references: [id], onDelete: Restrict)

  @@index([ocurridoEn(sort: Desc)], map: "idx_evento_ocurrido")
  @@map("evento")
}
