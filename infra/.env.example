# Copie este archivo a `infra/.env` y reemplace los secretos antes de desplegar.
#   Copy-Item infra/.env.example infra/.env

POSTGRES_USER=aquabrain
POSTGRES_PASSWORD=cambie_esta_clave
POSTGRES_DB=aquabrain
DB_PORT=5432

API_PORT=3000
WEB_PORT=8080
LOG_LEVEL=info

# Genere secretos propios, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambie_por_un_secreto_aleatorio_de_al_menos_32_bytes
JWT_REFRESH_SECRET=cambie_por_otro_secreto_aleatorio_de_al_menos_32_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
DEVICE_KEY_PEPPER=cambie_por_un_pepper_aleatorio_de_al_menos_32_bytes

ALERT_SILENCE_FACTOR=3
MAX_TIMESTAMP_SKEW=5m
BODY_LIMIT=1mb

# Origen del dashboard servido por nginx.
CORS_ORIGINS=http://localhost:8080
